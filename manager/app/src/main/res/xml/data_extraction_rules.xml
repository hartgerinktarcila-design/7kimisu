<data-extraction-rules>
    <cloud-backup>
        <!-- 应用锁密码不参与备份 -->
        <exclude domain="sharedpref" path="app_lock.xml"/>
        <exclude domain="file" path="applock.hash"/>
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>